<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>ClientGhostWatchdog</AssemblyName>
    <RootNamespace>ClientGhostWatchdog</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.2.0</Version>
    <PackageWebsiteUrl>https://github.com/dreamwraith/Valheim-ClientGhostWatchdog</PackageWebsiteUrl>
    <PackageDescription>Client-side watchdog mod for players connecting to Valheim servers that detects dropped connections and disconnects cleanly to prevent ghost desyncs.</PackageDescription>
    <Authors>DreamWraith</Authors>
    <Company>DreamWraith (https://github.com/dreamwraith)</Company>
    <Copyright>Copyright (c) 2026 DreamWraith</Copyright>
    <Description>$(PackageDescription)</Description>
    <PackageProjectUrl>https://github.com/dreamwraith/Valheim-ClientGhostWatchdog</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dreamwraith/Valheim-ClientGhostWatchdog</RepositoryUrl>
    <NexusModId>4328</NexusModId>
    <NexusFileId></NexusFileId>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.30.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Generate VersionInfo.g.cs from $(Version) so Plugin.ModVersion is always in sync -->
  <Target Name="GenerateVersionInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <VersionInfoFile>$(IntermediateOutputPath)VersionInfo.g.cs</VersionInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <VersionInfoLines Include="// &lt;auto-generated /&gt;" />
      <VersionInfoLines Include="namespace ClientGhostWatchdog" />
      <VersionInfoLines Include="{" />
      <VersionInfoLines Include="    internal static class VersionInfo" />
      <VersionInfoLines Include="    {" />
      <VersionInfoLines Include="        public const string Version = &quot;$(Version)&quot;%3B" />
      <VersionInfoLines Include="    }" />
      <VersionInfoLines Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(VersionInfoFile)" Lines="@(VersionInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(VersionInfoFile)" />
      <FileWrites Include="$(VersionInfoFile)" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="SyncManifestJson" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath ParameterType="System.String" Required="true" />
      <ModName ParameterType="System.String" Required="true" />
      <ModVersion ParameterType="System.String" Required="true" />
      <WebsiteUrl ParameterType="System.String" Required="true" />
      <ModDescription ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string content =
            "{\n" +
            "  \"name\": \"" + ModName + "\",\n" +
            "  \"version_number\": \"" + ModVersion + "\",\n" +
            "  \"website_url\": \"" + WebsiteUrl + "\",\n" +
            "  \"description\": \"" + ModDescription + "\",\n" +
            "  \"dependencies\": [\n" +
            "    \"denikson-BepInExPack_Valheim-5.4.2360\"\n" +
            "  ]\n" +
            "}\n";
        string existing = File.Exists(ManifestPath) ? File.ReadAllText(ManifestPath, Encoding.UTF8) : null;
        if (!string.Equals(existing, content, StringComparison.Ordinal))
        {
            File.WriteAllText(ManifestPath, content, new UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Keep manifest.json automatically synchronized with $(Version) and package properties using Unix LF endings -->
  <Target Name="GenerateManifest" BeforeTargets="BeforeBuild;PackageMod">
    <SyncManifestJson
      ManifestPath="$(ProjectDir)manifest.json"
      ModName="$(AssemblyName)"
      ModVersion="$(Version)"
      WebsiteUrl="$(PackageWebsiteUrl)"
      ModDescription="$(PackageDescription)" />
  </Target>

  <!-- Create Thunderstore / Nexus Mods distribution package on Release build -->
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(SkipPackageMod)' != 'true'" DependsOnTargets="GenerateManifest">
    <PropertyGroup>
      <PackageStagingDir>$(ProjectDir)bin\PackageTemp</PackageStagingDir>
      <PackagePublishDir>$(ProjectDir)bin\Publish</PackagePublishDir>
      <PackageZipFile>$(PackagePublishDir)\$(AssemblyName)-$(Version).zip</PackageZipFile>
    </PropertyGroup>
    <MakeDir Directories="$(PackageStagingDir);$(PackagePublishDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStagingDir)" />
    <Copy SourceFiles="$(ProjectDir)manifest.json" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)manifest.json')" />
    <Copy SourceFiles="$(ProjectDir)icon.png" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)icon.png')" />
    <Copy SourceFiles="$(ProjectDir)README.md" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)README.md')" />
    <Copy SourceFiles="$(ProjectDir)CHANGELOG.md" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)CHANGELOG.md')" />
    <Copy SourceFiles="$(ProjectDir)CONTRIBUTING.md" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)CONTRIBUTING.md')" />
    <Copy SourceFiles="$(ProjectDir)LICENSE.md" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)LICENSE.md')" />
    <ZipDirectory SourceDirectory="$(PackageStagingDir)" DestinationFile="$(PackageZipFile)" Overwrite="true" />
    <RemoveDir Directories="$(PackageStagingDir)" />
    <Message Importance="High" Text="[PackageMod] Successfully generated mod release package: $(PackageZipFile)" />
  </Target>
</Project>
